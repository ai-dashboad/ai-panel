# AI Panel Environment Configuration
# Copy this file to .env and fill in your values

# Database
MYSQL_PASSWORD=your_secure_password

# Redis
REDIS_PASSWORD=

# AI Provider API Keys
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Docker Registry (for production)
DOCKER_REGISTRY=your-registry.com/ai-panel
VERSION=latest

# Apollo Configuration (optional)
APOLLO_ENABLED=false
APOLLO_META=http://localhost:8080

# JWT Secret (shared by ai-panel-user, ai-panel-gateway and workers/subscriptions)
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# Shared secret for service-to-service calls to the Cloudflare Workers
# (X-Internal-Token header; e.g. dispatch -> billing quota check).
# Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=change_me

# Eureka (service registry is protected by HTTP basic auth)
EUREKA_USER=admin
EUREKA_PASSWORD=change_me
EUREKA_URL=http://localhost:8761/eureka/
