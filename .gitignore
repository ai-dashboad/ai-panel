# =============================================================================
# AI Panel — .gitignore
# =============================================================================

# ---- Environment & secrets --------------------------------------------------
.env
.env.*
!.env.example
*.env
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
!Dockerfile.key
*.p12
*.jks
*.keystore
secrets/
credentials/

# ---- Java / Maven -----------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
hs_err_pid*
replay_pid*

# ---- Node / frontend --------------------------------------------------------
node_modules/
dist/
dist-ssr/
.npm/
.pnpm-store/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Compiled output of ai-panel-ui/vite.config.ts (generated by `vue-tsc -b`)
ai-panel-ui/vite.config.js
ai-panel-ui/vite.config.d.ts

# ---- Playwright / tests -----------------------------------------------------
playwright-report/
test-results/
blob-report/
playwright/.cache/
coverage/
htmlcov/
.pytest_cache/
*.cover

# ---- Cloudflare Workers (local Miniflare state incl. D1/KV SQLite DBs) ------
.wrangler/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# ---- Python ------------------------------------------------------------------
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# ---- Large media ------------------------------------------------------------
*.mp4
*.mov
*.webm
*.wav

# ---- Logs & temp files ------------------------------------------------------
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ---- IDEs -------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
.sts4-cache/
out/
build/

# ---- OS ---------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini

# ---- Docker -----------------------------------------------------------------
docker-compose.override.yml

# ---- AI-assistant / local tooling config (not part of the public repo) -------
# AGENTS.md is the only committed agent guide.
CLAUDE.md
.claude/
.codex/
.agents/
.cursor/
.mcp.json
.playwright-mcp/
