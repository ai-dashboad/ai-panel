FROM eclipse-temurin:17-jre

LABEL maintainer="AI Panel Team"
LABEL description="AI Panel Analytics Service - Usage & Metrics"

WORKDIR /app

RUN groupadd -r aipanel && useradd -r -g aipanel aipanel

COPY ai-panel-analytics/analytics-web/target/analytics-web-*.jar app.jar

RUN chown -R aipanel:aipanel /app

USER aipanel

EXPOSE 8087

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -sf http://localhost:8087/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "-Xms512m", "-Xmx1g", "-Djava.security.egd=file:/dev/./urandom", "app.jar"]
