FROM eclipse-temurin:17-jre

LABEL maintainer="AI Panel Team"
LABEL description="AI Panel Dispatch Service"

WORKDIR /app

RUN groupadd -r aipanel && useradd -r -g aipanel aipanel

COPY ai-panel-dispatch/dispatch-web/target/dispatch-web-*.jar app.jar

RUN chown -R aipanel:aipanel /app

USER aipanel

EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -sf http://localhost:8082/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "-Xms512m", "-Xmx1g", "-Djava.security.egd=file:/dev/./urandom", "app.jar"]
