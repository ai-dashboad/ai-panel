FROM eclipse-temurin:17-jre

LABEL maintainer="AI Panel Team"
LABEL description="AI Panel User Service"

WORKDIR /app

RUN groupadd -r aipanel && useradd -r -g aipanel aipanel

COPY ai-panel-user/user-web/target/user-web-*.jar app.jar

RUN chown -R aipanel:aipanel /app

USER aipanel

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -sf http://localhost:8081/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "-Xms256m", "-Xmx512m", "-Djava.security.egd=file:/dev/./urandom", "app.jar"]
